{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://sparkjury.local/skills-governance/sparkjury-govern/schemas/io.schema.json",
  "title": "GovernIO",
  "description": "sparkjury-govern（pack 生命周期治理）的输入输出契约。envelope 层见 contracts/skill-envelope.schema.json；ledger 事件结构见 contracts/event-ledger.schema.json。govern 产出提案与治理记录，不 apply 任何 pack 变更。",
  "type": "object",
  "required": ["input", "output"],
  "properties": {
    "input": {
      "type": "object",
      "required": ["pack_manifest_path", "action"],
      "properties": {
        "action": {
          "enum": ["freeze", "thaw", "verify", "bump", "ledger_append", "ledger_query",
                   "ledger_export", "proposals", "history"],
          "description": "govern subcommand；freeze/thaw/verify 一律转调 tools/pack_freeze.py"
        },
        "pack_manifest_path": { "type": "string", "description": "standards/scenario-pack/pack.manifest.json" },
        "pack_dir": { "type": "string", "description": "standards/scenario-pack/ 路径（内容只读）" },
        "ledger_path": { "type": "string", "description": "events.jsonl，append-only" },
        "out_dir": { "type": "string", "description": "governance/ 输出目录" },
        "reason": {
          "type": "string",
          "description": "thaw 必填；缺失即拒绝（无据解冻禁止）"
        },
        "change_summary": { "type": "string", "description": "freeze/bump 必填，进版本链" },
        "decision_event_id": { "type": "string", "description": "批准本次变更的人 decision 事件 id" },
        "actor": { "type": "string" },
        "run_id": { "type": "string", "default": "governance" }
      }
    },
    "output": {
      "type": "object",
      "required": ["pack_history", "governance_log", "proposals"],
      "properties": {
        "pack_history": {
          "type": "object",
          "required": ["entries"],
          "properties": {
            "pack_id": { "type": "string" },
            "current_version": { "type": "string" },
            "current_state": { "enum": ["DRAFT", "FROZEN"] },
            "frozen_hash": { "type": ["string", "null"] },
            "entries": {
              "type": "array",
              "items": {
                "type": "object",
                "required": ["action", "ts"],
                "properties": {
                  "action": { "enum": ["bump", "freeze", "thaw"] },
                  "ts": { "type": "string" },
                  "version": { "type": ["string", "null"] },
                  "state": { "type": "string" },
                  "frozen_hash": { "type": ["string", "null"] },
                  "change_summary": { "type": "string" },
                  "rationale": { "type": "string" },
                  "decision_event_id": { "type": ["string", "null"] },
                  "event_id": { "type": "string" },
                  "actor": { "type": "string" }
                }
              }
            }
          }
        },
        "governance_log": {
          "type": "array",
          "description": "追加型治理动作日志，按 action_key 幂等，既有条目不改写",
          "items": {
            "type": "object",
            "required": ["action_key", "ts", "action"],
            "properties": {
              "action_key": { "type": "string" },
              "ts": { "type": "string" },
              "action": { "enum": ["freeze", "thaw", "verify"] },
              "ok": { "type": "boolean" },
              "detail": { "type": "string" },
              "event_id": { "type": "string" },
              "pack_id": { "type": "string" },
              "version": { "type": "string" },
              "state": { "type": "string" },
              "frozen_hash": { "type": ["string", "null"] }
            }
          }
        },
        "proposals": {
          "type": "object",
          "required": ["proposals", "summary", "support_threshold"],
          "properties": {
            "generated_at": { "type": "string" },
            "pack": {
              "type": "object",
              "properties": {
                "pack_id": { "type": "string" },
                "version": { "type": "string" },
                "state": { "enum": ["DRAFT", "FROZEN"] }
              }
            },
            "ledger": {
              "type": "object",
              "properties": {
                "path": { "type": "string" },
                "events": { "type": "integer" },
                "decisions": { "type": "integer" },
                "corrupt_lines": { "type": "integer" }
              }
            },
            "support_threshold": { "type": "integer", "description": "契约常量 MIN_SUPPORT，默认 2" },
            "proposals": {
              "type": "array",
              "items": { "$ref": "#/$defs/golden_proposal" }
            },
            "summary": {
              "type": "object",
              "properties": {
                "priority_weight_calibration": { "type": "integer" },
                "taxonomy_gap": { "type": "integer" },
                "fixability_prior_calibration": { "type": "integer" }
              }
            }
          }
        }
      }
    }
  },
  "$defs": {
    "golden_proposal": {
      "type": "object",
      "required": ["proposal_id", "signal", "status", "required_decision_kind",
                   "target_file", "field", "current", "proposed", "evidence"],
      "properties": {
        "proposal_id": { "type": "string", "pattern": "^P-\\d{3}$" },
        "signal": {
          "enum": ["priority_weight_calibration", "taxonomy_gap", "fixability_prior_calibration"]
        },
        "status": {
          "const": "pending_human_approval",
          "description": "恒为待人批准；govern 无 apply 能力"
        },
        "required_decision_kind": { "const": "approve_pack_diff" },
        "target_file": { "type": "string" },
        "field": { "type": "string" },
        "current": {
          "description": "pack 现值（由扫描读出）；taxonomy 新增类时为 null",
          "type": ["string", "number", "boolean", "array", "null"]
        },
        "proposed": {
          "const": null,
          "description": "恒为 null：govern 只给方向，数值由人定后交 clarify 编译"
        },
        "direction": { "enum": ["raise", "lower", "add"] },
        "candidate_fields": { "type": "array", "items": { "type": "string" } },
        "evidence": {
          "type": "object",
          "required": ["decision_kind", "support", "event_ids"],
          "properties": {
            "decision_kind": { "type": "string" },
            "key": { "type": "string" },
            "support": { "type": "integer" },
            "accept_count": { "type": "integer" },
            "reject_count": { "type": "integer" },
            "accept_rate": { "type": "number" },
            "recurring_human_label": { "type": "string" },
            "clusters": { "type": "array", "items": { "type": "string" } },
            "system_top": { "type": "string" },
            "human_top": { "type": "string" },
            "event_ids": {
              "type": "array",
              "items": { "type": "string" },
              "minItems": 1,
              "description": "证据必须能追到 ledger 事件，禁止无证据提案"
            }
          }
        },
        "notes": { "type": "string" }
      }
    }
  }
}
